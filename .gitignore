# --- node (runtime build) ---
node_modules/
dist/
*.log
.runs/
.plans/

# --- rust (cli) ---
/target/
crates/**/target/

# --- os / editor ---
.DS_Store
*.swp
*~
.idea/
.vscode/
.env
.env.*

# --- artefatos compilados do runtime: gerados pelo build, mas os fragmentos
# minificados e o manifesto são commitados de propósito — o build da CLI Rust
# roda sem node. ---
runtime/dist/*
!runtime/dist/
!runtime/dist/core.min.js
!runtime/dist/copy.min.js
!runtime/dist/toc.min.js
!runtime/dist/lightbox.min.js
!runtime/dist/runtime.min.js
!runtime/dist/manifest.json
