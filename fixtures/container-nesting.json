{
  "id": "container-nesting",
  "requirement": "COMP-02",
  "status": "valid",
  "warnings": ["W-COMP-02"],
  "source": "::: note\nOuter.\n\n::: mystery\nInner.\n:::\n:::\n",
  "expect": {
    "ast": {
      "type": "container",
      "name": "note",
      "argument": null,
      "children": [
        { "type": "paragraph", "text": "Outer." },
        {
          "type": "container",
          "name": "mystery",
          "argument": null,
          "children": [{ "type": "paragraph", "text": "Inner." }]
        }
      ]
    },
    "html": "<aside class=\"md-callout md-note\"><span class=\"md-callout-badge\">Note</span><p>Outer.</p><p>Inner.</p></aside>",
    "warnings": [
      { "code": "W-COMP-02", "name": "mystery", "target": null }
    ],
    "cases": [
      {
        "name": "braced-nested-mismatched-fence",
        "source": "::: note\nOuter.\n\n:::: {.mystery}\nInner.\n:::\n:::\n",
        "expect": {
          "ast": {
            "type": "container",
            "name": "note",
            "argument": null,
            "children": [
              { "type": "paragraph", "text": "Outer." },
              {
                "type": "container",
                "name": "mystery",
                "argument": null,
                "children": [{ "type": "paragraph", "text": "Inner." }]
              }
            ]
          },
          "html": "<aside class=\"md-callout md-note\"><span class=\"md-callout-badge\">Note</span><p>Outer.</p><p>Inner.</p></aside>",
          "warnings": [
            { "code": "W-COMP-02", "name": "mystery", "target": null }
          ]
        }
      },
      {
        "name": "unclosed-opener",
        "source": "::: warning\n",
